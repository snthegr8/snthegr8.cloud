---
/**
 * Desktop Mollie (potcake):
 * Runs to the content edge once → faces you → chat bubbles (first vs return)
 * → shakes, puffs out → later a random "i'm still here lol" echo in the viewport.
 */
---

<div class="mollie" data-mollie hidden aria-hidden="true">
	<div class="mollie__actor" data-mollie-actor>
		<div class="mollie__turn" data-mollie-turn>
			<div class="mollie__run" data-mollie-run>
				<svg class="mollie__svg mollie__side" viewBox="0 0 96 64" width="104" height="70" aria-hidden="true">
					<path
						class="tail"
						d="M16 36c-7 3-11-1-9-8 3-5 9-2 11 3"
						stroke="currentColor"
						stroke-width="3"
						stroke-linecap="round"
						fill="none"
					/>
					<ellipse cx="46" cy="38" rx="23" ry="13" fill="currentColor" />
					<ellipse cx="54" cy="40" rx="9" ry="7" fill="var(--cream)" opacity="0.32" />
					<ellipse cx="70" cy="27" rx="13" ry="11" fill="currentColor" />
					<ellipse cx="81" cy="29" rx="6.5" ry="4.5" fill="var(--cream)" opacity="0.5" />
					<circle cx="84.5" cy="29" r="1.7" fill="var(--brown)" />
					<path d="M62 18c-1-8 5-12 10-7 2 2 1 8-2 10" fill="currentColor" />
					<circle cx="74" cy="24" r="2" fill="var(--cream)" />
					<circle cx="74.6" cy="24.2" r="0.9" fill="var(--brown)" />
					<path d="M78 32c2 2 5 2 7 0" stroke="var(--brown)" stroke-width="1.2" stroke-linecap="round" fill="none" opacity="0.55" />
					<rect class="leg leg-a" x="32" y="47" width="4" height="13" rx="2" fill="currentColor" />
					<rect class="leg leg-b" x="42" y="47" width="4" height="13" rx="2" fill="currentColor" />
					<rect class="leg leg-c" x="52" y="47" width="4" height="13" rx="2" fill="currentColor" />
					<rect class="leg leg-d" x="61" y="47" width="4" height="13" rx="2" fill="currentColor" />
				</svg>
			</div>

			<svg class="mollie__svg mollie__front" viewBox="0 0 80 72" width="88" height="80" aria-hidden="true">
				<path d="M18 28c-4-14 6-18 12-10 2 3 1 9-2 12" fill="currentColor" />
				<path d="M62 28c4-14-6-18-12-10-2 3-1 9 2 12" fill="currentColor" />
				<ellipse cx="40" cy="34" rx="22" ry="20" fill="currentColor" />
				<ellipse cx="40" cy="42" rx="11" ry="8" fill="var(--cream)" opacity="0.55" />
				<ellipse cx="40" cy="39" rx="3.2" ry="2.4" fill="var(--brown)" />
				<path
					class="smile smile-rest"
					d="M33 44c3 4 11 4 14 0"
					stroke="var(--brown)"
					stroke-width="1.6"
					stroke-linecap="round"
					fill="none"
				/>
				<path
					class="smile smile-big"
					d="M31 43c4 6 14 6 18 0"
					stroke="var(--brown)"
					stroke-width="2"
					stroke-linecap="round"
					fill="none"
				/>
				<g class="eye eye-left">
					<ellipse cx="31" cy="30" rx="3.2" ry="3.6" fill="var(--cream)" />
					<circle cx="31.4" cy="30.4" r="1.4" fill="var(--brown)" />
				</g>
				<g class="eye eye-right">
					<ellipse class="eye-open" cx="49" cy="30" rx="3.2" ry="3.6" fill="var(--cream)" />
					<circle class="eye-open" cx="48.6" cy="30.4" r="1.4" fill="var(--brown)" />
					<path class="eye-wink" d="M45.5 30.5c2.2-2 5.8-2 8 0" stroke="var(--brown)" stroke-width="1.7" stroke-linecap="round" fill="none" />
				</g>
				<ellipse cx="40" cy="62" rx="16" ry="8" fill="currentColor" />
				<ellipse cx="40" cy="60" rx="8" ry="4" fill="var(--cream)" opacity="0.3" />
			</svg>

			<div class="mollie__chat" data-mollie-chat>
				<p class="mollie__bubble" data-mollie-bubble></p>
			</div>

			<div class="mollie__puff" data-mollie-puff aria-hidden="true">
				<span></span><span></span><span></span><span></span><span></span><span></span>
			</div>
		</div>
	</div>
</div>

<p class="mollie__echo" data-mollie-echo hidden aria-hidden="true">i'm still here lol</p>

<style>
	.mollie {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		overflow: hidden;
		perspective: 700px;
	}

	@media (min-width: 960px) {
		.mollie:not([hidden]) {
			display: block;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mollie,
		.mollie__echo {
			display: none !important;
		}
	}

	.mollie__actor {
		position: absolute;
		bottom: 1.75rem;
		left: 0;
		width: 104px;
		height: 80px;
		will-change: transform;
	}

	.mollie__turn {
		position: relative;
		width: 100%;
		height: 100%;
		color: var(--peach);
		transform-style: preserve-3d;
		transform-origin: center center;
		will-change: transform;
	}

	.mollie__run {
		position: absolute;
		inset: 0;
		transform-origin: center center;
	}

	/* Default side SVG faces right; mirror when running left (e.g. entering from the right). */
	.mollie__run.is-face-left {
		transform: scaleX(-1);
	}

	.mollie__svg {
		position: absolute;
		left: 50%;
		bottom: 0;
		overflow: visible;
		backface-visibility: hidden;
	}

	.mollie__side {
		transform: translateX(-50%);
		opacity: 1;
	}

	.mollie__front {
		transform: translateX(-50%) rotateY(180deg);
		opacity: 0;
		pointer-events: none;
	}

	.mollie__turn.is-facing-you .mollie__run {
		opacity: 0;
	}

	.mollie__turn.is-facing-you .mollie__front {
		opacity: 1;
		transform: translateX(-50%) rotateY(0deg);
	}

	.mollie__actor.is-running .leg-a,
	.mollie__actor.is-running .leg-c {
		transform-origin: top center;
		animation: mollie-stride 0.26s ease-in-out infinite;
	}

	.mollie__actor.is-running .leg-b,
	.mollie__actor.is-running .leg-d {
		transform-origin: top center;
		animation: mollie-stride 0.26s ease-in-out infinite reverse;
	}

	.mollie__actor.is-running .tail {
		transform-origin: 16px 36px;
		animation: mollie-wag 0.32s ease-in-out infinite;
	}

	@keyframes mollie-stride {
		0%,
		100% {
			transform: rotate(-16deg) translateY(0);
		}
		50% {
			transform: rotate(20deg) translateY(-2px);
		}
	}

	@keyframes mollie-wag {
		0%,
		100% {
			transform: rotate(-14deg);
		}
		50% {
			transform: rotate(16deg);
		}
	}

	.eye-wink {
		opacity: 0;
	}

	.mollie__turn.is-winking .eye-right .eye-open {
		opacity: 0;
	}

	.mollie__turn.is-winking .eye-right .eye-wink {
		opacity: 1;
	}

	.smile-big {
		opacity: 0;
	}

	.mollie__turn.is-smiling .smile-rest {
		opacity: 0;
	}

	.mollie__turn.is-smiling .smile-big {
		opacity: 1;
	}

	.mollie__chat {
		position: absolute;
		left: 50%;
		bottom: 100%;
		width: max-content;
		max-width: 11.5rem;
		transform: translate(-50%, -0.35rem);
		opacity: 0;
		pointer-events: none;
	}

	.mollie__chat.is-open {
		opacity: 1;
	}

	.mollie__bubble {
		margin: 0;
		padding: 0.45rem 0.65rem;
		border-radius: 10px 10px 10px 3px;
		background: color-mix(in srgb, var(--cream) 88%, var(--green));
		border: 1px solid color-mix(in srgb, var(--brown) 18%, transparent);
		color: var(--green);
		font-family: 'LinuxLibertine', ui-serif, serif;
		font-size: 0.75rem;
		line-height: 1.35;
		letter-spacing: 0.01em;
		box-shadow: 0 6px 18px color-mix(in srgb, var(--brown) 12%, transparent);
	}

	.mollie__bubble::after {
		content: '';
		position: absolute;
		/* decorative — parent is relative via actor */
	}

	.mollie__actor.is-from-right .mollie__bubble {
		border-radius: 10px 10px 3px 10px;
	}

	.mollie__puff {
		position: absolute;
		inset: 10% 15%;
		opacity: 0;
		pointer-events: none;
	}

	.mollie__puff.is-on {
		opacity: 1;
	}

	.mollie__puff span {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 10px;
		height: 10px;
		margin: -5px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--peach) 70%, var(--cream));
		opacity: 0;
	}

	.mollie__puff.is-on span {
		animation: mollie-puff 0.7s ease-out forwards;
	}

	.mollie__puff span:nth-child(1) {
		--dx: -28px;
		--dy: -18px;
		animation-delay: 0s;
	}
	.mollie__puff span:nth-child(2) {
		--dx: 22px;
		--dy: -24px;
		animation-delay: 0.04s;
	}
	.mollie__puff span:nth-child(3) {
		--dx: -18px;
		--dy: 16px;
		animation-delay: 0.08s;
	}
	.mollie__puff span:nth-child(4) {
		--dx: 26px;
		--dy: 12px;
		animation-delay: 0.1s;
	}
	.mollie__puff span:nth-child(5) {
		--dx: 4px;
		--dy: -30px;
		animation-delay: 0.06s;
	}
	.mollie__puff span:nth-child(6) {
		--dx: -8px;
		--dy: 26px;
		animation-delay: 0.12s;
	}

	@keyframes mollie-puff {
		0% {
			opacity: 0.9;
			transform: translate(0, 0) scale(0.4);
		}
		100% {
			opacity: 0;
			transform: translate(var(--dx), var(--dy)) scale(1.8);
		}
	}

	.mollie__echo {
		position: fixed;
		z-index: 3;
		margin: 0;
		padding: 0;
		font-family: 'LinuxLibertine', ui-serif, serif;
		font-size: 0.8rem;
		font-style: italic;
		letter-spacing: 0.03em;
		color: color-mix(in srgb, var(--brown) 45%, transparent);
		pointer-events: none;
		opacity: 0;
		user-select: none;
	}
</style>

<script>
	import gsap from 'gsap';
	import { completeMollieSession, setMollieSpeaking } from '../lib/mollie-signal';

	const DESKTOP_MQ = '(min-width: 960px)';
	const CONTENT_MAX = 720;
	const CONTENT_GUTTER = 16;
	const EDGE_GAP = 28;
	const CORNER_PAD = 28;
	const DOG_W = 104;
	const STORAGE_KEY = 'mollie-met';
	const LAST_SCRIPT_KEY = 'mollie-last-script';
	/** Returning visitors see Mollie about 2 in 5 page loads. */
	const RETURN_APPEAR_CHANCE = 1 / 3;

	const FIRST_LINES = [
		'hello.',
    "mollie here !",
    'yeah i speak, lol',
    "i hope you have a great time here"
	];

	const RETURN_SCRIPTS: string[][] = [
		["it's you again.", 'sn says hi.', 'i think you should wave at him via mail.'],
    ['oh. you.', 'i hope you\'ve had a meal today', 'could you reach out to sn, to stretch ?'],
		['back so soon?', 'i kept your seat warm.', '…metaphorically. i sat on the keyboard.'],
    ['hey.', 'sn mumbled your name earlier.', 'or maybe i heard wrong, he probably said f**k.'],
    ["didn't expect you.", 'nice timing though.', "he's deep in a rabbit hole, interrupt wisely."],
		['look who it is.', 'i practiced my wink.', 'rate it out of ten. silently.'],
    ['welcome back.', 'my owner sn, dumb', "why's the bicycle empty ? tell him to do better"],
		['hi again.', 'sn says the site is “almost done.”', 'he said that yesterday too.'],
		['you returned.', 'brave.', 'or bored. either works.'],
    ['meow ! yea i know i am a dog, please allow', "there's leftover coffee energy in the room.", 'steal some via email.'],
    ['again?', 'i approve.', 'send sn a tiny hello, he pretends not to check mail.'],
		['hey stranger.', 'jk. i remember you.', 'sn probably does too. wave at him.'],
		['you found your way back.', 'impressive navigation.', 'or muscle memory. still cool.'],
		['hi.', 'sn is pretending to be productive.', 'a short mail ruins the bit in a good way.'],
		['well well.', 'the site missed you. allegedly.', 'i definitely did.'],
		['back for more?', 'take the scenic route through the posts.', 'then poke sn via mail.'],
		['noticed you.', 'sn will too if you write.', 'keep it short. he skims like a dog.'],
		['reappearance unlocked.', 'achievement: mollie approved.', 'bonus xp if you email sn.'],
    ['oh it’s you.', 'perfect.', 'go read something, then say hi to sn.'],
		['return visitor detected.', 'initiating friendliness.', 'mission: make you email the human.'],
	];

	const pick = <T,>(items: T[]) => items[Math.floor(Math.random() * items.length)]!;

	const pickReturnScript = (): string[] => {
		let last = -1;
		try {
			last = Number(localStorage.getItem(LAST_SCRIPT_KEY) ?? '-1');
		} catch {
			/* ignore */
		}
		const options =
			RETURN_SCRIPTS.length > 1
				? RETURN_SCRIPTS.map((script, i) => ({ script, i })).filter(({ i }) => i !== last)
				: RETURN_SCRIPTS.map((script, i) => ({ script, i }));
		const chosen = pick(options);
		try {
			localStorage.setItem(LAST_SCRIPT_KEY, String(chosen.i));
		} catch {
			/* ignore */
		}
		return chosen.script;
	};

	const root = document.querySelector<HTMLElement>('[data-mollie]');
	const actor = document.querySelector<HTMLElement>('[data-mollie-actor]');
	const turn = document.querySelector<HTMLElement>('[data-mollie-turn]');
	const runFace = document.querySelector<HTMLElement>('[data-mollie-run]');
	const chat = document.querySelector<HTMLElement>('[data-mollie-chat]');
	const bubble = document.querySelector<HTMLElement>('[data-mollie-bubble]');
	const puff = document.querySelector<HTMLElement>('[data-mollie-puff]');
	const echo = document.querySelector<HTMLElement>('[data-mollie-echo]');

	if (root && actor && turn && runFace && chat && bubble && puff && echo) {
		const desktop = window.matchMedia(DESKTOP_MQ);
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let startTimer = 0;
		let echoTimer = 0;
		let tween: gsap.core.Timeline | null = null;
		let started = false;

		const isReturn = () => {
			try {
				return localStorage.getItem(STORAGE_KEY) === '1';
			} catch {
				return false;
			}
		};

		const markMet = () => {
			try {
				localStorage.setItem(STORAGE_KEY, '1');
			} catch {
				/* ignore */
			}
		};

		const contentEdges = () => {
			const contentWidth = Math.min(CONTENT_MAX, window.innerWidth - CONTENT_GUTTER * 2);
			const left = (window.innerWidth - contentWidth) / 2;
			return { left, right: left + contentWidth };
		};

		const resetPose = () => {
			actor.classList.remove('is-running', 'is-from-right');
			runFace.classList.remove('is-face-left');
			turn.classList.remove('is-facing-you', 'is-winking', 'is-smiling');
			chat.classList.remove('is-open');
			puff.classList.remove('is-on');
			bubble.textContent = '';
			gsap.set(turn, { rotateY: 0, scale: 1, opacity: 1, x: 0, y: 0 });
			gsap.set(actor, { x: 0, y: 0, rotation: 0, scale: 1, opacity: 1 });
		};

		const hide = () => {
			resetPose();
			root.hidden = true;
			setMollieSpeaking(false);
			completeMollieSession();
		};

		const stopAll = () => {
			window.clearTimeout(startTimer);
			window.clearTimeout(echoTimer);
			tween?.kill();
			tween = null;
			hide();
			echo.hidden = true;
			gsap.set(echo, { opacity: 0 });
		};

		/** Face the direction of travel. Side art defaults to facing right. */
		const faceTravel = (movingLeft: boolean) => {
			turn.classList.remove('is-facing-you', 'is-winking', 'is-smiling');
			chat.classList.remove('is-open');
			runFace.classList.toggle('is-face-left', movingLeft);
			gsap.set(turn, { rotateY: 0 });
		};

		const say = (line: string) => {
			bubble.textContent = line;
			chat.classList.add('is-open');
			gsap.fromTo(
				chat,
				{ y: 6, opacity: 0 },
				{ y: 0, opacity: 1, duration: 0.28, ease: 'power2.out' },
			);
		};

		const scheduleEcho = () => {
			window.clearTimeout(echoTimer);
			echoTimer = window.setTimeout(() => {
				if (!desktop.matches || reduceMotion.matches) return;
				const pad = 48;
				const x = pad + Math.random() * Math.max(80, window.innerWidth - pad * 2 - 120);
				const y = pad + Math.random() * Math.max(80, window.innerHeight - pad * 2 - 40);
				echo.hidden = false;
				gsap.set(echo, { left: x, top: y, opacity: 0, scale: 0.95 });
				gsap.to(echo, {
					opacity: 0.85,
					scale: 1,
					duration: 0.6,
					ease: 'power2.out',
				});
				gsap.to(echo, {
					opacity: 0,
					duration: 1.2,
					delay: 3.2,
					ease: 'power1.in',
					onComplete: () => {
						echo.hidden = true;
					},
				});
			}, 4000 + Math.random() * 8000);
		};

		const runConversation = () => {
			if (!desktop.matches || reduceMotion.matches) {
				stopAll();
				completeMollieSession();
				return;
			}

			const returning = isReturn();
			// First-timers always meet Mollie; returns only ~2/5 visits
			if (returning && Math.random() >= RETURN_APPEAR_CHANCE) {
				completeMollieSession();
				return;
			}

			const lines = returning ? pickReturnScript() : FIRST_LINES;

			root.hidden = false;
			setMollieSpeaking(true);
			const side: 'left' | 'right' = Math.random() > 0.45 ? 'right' : 'left';
			const { left, right } = contentEdges();
			const startX = side === 'right' ? window.innerWidth + 8 : -DOG_W - 8;
			const stopX = side === 'right' ? right + EDGE_GAP : left - EDGE_GAP - DOG_W;
			const movingLeft = stopX < startX;

			resetPose();
			actor.classList.toggle('is-from-right', side === 'right');
			actor.style.bottom = `${CORNER_PAD}px`;
			faceTravel(movingLeft);
			actor.classList.add('is-running');
			gsap.set(actor, { x: startX, y: 0, opacity: 1, scale: 1 });

			tween?.kill();
			tween = gsap.timeline({
				onComplete: () => {
					markMet();
					hide();
					scheduleEcho();
				},
			});

			tween
				.to(actor, {
					x: stopX,
					duration: 2.35 + Math.random() * 0.45,
					ease: 'power1.inOut',
				})
				.add(() => actor.classList.remove('is-running'))
				.to(turn, {
					rotateY: movingLeft ? -80 : 80,
					duration: 0.32,
					ease: 'power2.in',
				})
				.add(() => {
					gsap.set(turn, { rotateY: 0 });
					runFace.classList.remove('is-face-left');
					turn.classList.add('is-facing-you', 'is-smiling');
				})
				.fromTo(
					turn,
					{ scale: 0.92, opacity: 0.85 },
					{ scale: 1, opacity: 1, duration: 0.22, ease: 'power2.out' },
				)
				.add(() => turn.classList.add('is-winking'))
				.to({}, { duration: 0.35 })
				.add(() => turn.classList.remove('is-winking'));

			for (const line of lines) {
				tween.add(() => say(line)).to({}, { duration: 2.1 });
			}

			tween
				.add(() => {
					chat.classList.remove('is-open');
				})
				// Shaky exit
				.to(turn, {
					x: 5,
					duration: 0.05,
					yoyo: true,
					repeat: 11,
					ease: 'none',
				})
				.add(() => {
					puff.classList.add('is-on');
				})
				.to(actor, {
					scale: 0.12,
					opacity: 0,
					duration: 0.38,
					ease: 'power2.in',
				})
				.to({}, { duration: 0.4 })
				.add(() => puff.classList.remove('is-on'));
		};

		const sync = () => {
			if (!desktop.matches || reduceMotion.matches) {
				stopAll();
				completeMollieSession();
				started = false;
				return;
			}
			if (started) return;
			started = true;
			startTimer = window.setTimeout(() => runConversation(), 2200 + Math.random() * 1600);
		};

		desktop.addEventListener('change', sync);
		reduceMotion.addEventListener('change', sync);
		sync();
	} else {
		completeMollieSession();
	}
</script>

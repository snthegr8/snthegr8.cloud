---
import BicycleCanvas from './BicycleCanvas.astro';
import HeaderLink from './HeaderLink.astro';
import Potcake from './Potcake.astro';

/** Individual posts only — keep bike on /blog index. */
const isBlogPost = /^\/blog\/[^/]+/.test(Astro.url.pathname);
---

{!isBlogPost && <BicycleCanvas />}
<Potcake />
<header>
	<nav>
		<a href="/" class="site-title">sn</a>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/notes">Notes</HeaderLink>
			<HeaderLink href="/links">Links</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 1.75rem 0 0.5rem;
		background: transparent;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 720px;
		max-width: calc(100% - 2rem);
		margin: 0 auto;
		padding: 0.75rem 1rem;
	}

	@media (max-width: 720px) {
		header {
			padding: 1.25rem 0 0.25rem;
		}
	}

	.site-title {
		color: var(--green);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: 0.05em;
		text-transform: lowercase;
	}

	.site-title:hover {
		color: var(--brown);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.nav-links :global(a) {
		color: var(--peach);
		text-decoration: none;
		font-size: 0.875rem;
		text-transform: lowercase;
	}

	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		color: var(--green);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>

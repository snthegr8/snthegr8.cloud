---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="site-title">sn</a>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 0;
		background: transparent;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 720px;
		max-width: calc(100% - 2rem);
		margin: 0 auto;
		padding: 0 1rem;
	}

	.site-title {
		color: var(--green);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: 0.05em;
		text-transform: lowercase;
	}

	.site-title:hover {
		color: var(--brown);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.nav-links :global(a) {
		color: var(--peach);
		text-decoration: none;
		font-size: 0.875rem;
		text-transform: lowercase;
	}

	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		color: var(--green);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>

---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { formatNoteTimestamp, parseNoteTimestamp } from '../../lib/notes';

export async function getStaticPaths({ paginate }) {
	const notes = (await getCollection('notes'))
		.map((note) => ({
			...note,
			pubDate: parseNoteTimestamp(note.id),
		}))
		.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

	return paginate(notes, { pageSize: 10 });
}

const { page } = Astro.props;

const notes = await Promise.all(
	page.data.map(async (note) => {
		const { Content } = await render(note);
		return { note, Content, pubDate: note.pubDate as Date };
	}),
);

const pageLabel =
	page.currentPage > 1 ? `Notes · page ${page.currentPage}` : 'Notes';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${pageLabel} · ${SITE_TITLE}`}
			description="Short notes and thoughts."
			image="/og/notes.png"
		/>
	</head>
	<body>
		<Header />
		<main class="notes">
			<h1>notes.</h1>

			{
				notes.length === 0 ? (
					<p class="empty">No notes yet.</p>
				) : (
					<ol class="feed">
						{notes.map(({ Content, pubDate }) => (
							<li>
								<p class="note-meta">
									<time datetime={pubDate.toISOString()}>
										{formatNoteTimestamp(pubDate)}
									</time>
								</p>
								<div class="note-body">
									<Content />
								</div>
							</li>
						))}
					</ol>
				)
			}

			{
				(page.url.prev || page.url.next) && (
					<nav class="pager" aria-label="Notes pagination">
						{page.url.prev && <a href={page.url.prev}>← newer</a>}
						{page.url.next && <a href={page.url.next}>older →</a>}
					</nav>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.notes {
		padding-top: 2.5rem;
		padding-bottom: 4rem;
	}

	h1 {
		margin: 0 0 2rem;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		color: color-mix(in srgb, var(--brown) 55%, transparent);
	}

	.empty {
		margin: 0;
		font-size: 0.9375rem;
		color: color-mix(in srgb, var(--brown) 70%, transparent);
	}

	.feed {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.feed > li {
		padding: 1.25rem 0;
		border-top: 1px solid color-mix(in srgb, var(--brown) 12%, transparent);
	}

	.feed > li:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--brown) 12%, transparent);
	}

	.note-meta {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		color: color-mix(in srgb, var(--brown) 55%, transparent);
	}

	.note-body {
		font-size: 0.9375rem;
		line-height: 1.7;
		color: color-mix(in srgb, var(--brown) 90%, transparent);
	}

	.note-body :global(p) {
		margin: 0 0 0.75rem;
	}

	.note-body :global(p:last-child) {
		margin-bottom: 0;
	}

	.pager {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 1.25rem;
		margin-top: 2rem;
		font-size: 0.875rem;
	}

	.pager a {
		text-decoration: none;
		color: var(--peach);
		text-transform: lowercase;
	}

	.pager a:hover {
		color: var(--green);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
